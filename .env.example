# ============================================================
# AI Language Tutor — переменные окружения
# Скопируй этот файл в .env и заполни ключи
# ============================================================

# ОБЯЗАТЕЛЬНО: Gemini AI (бесплатно, 15 req/min)
# Получить на: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ОПЦИОНАЛЬНО: Deepgram (голос → текст, $200 бесплатных кредитов)
# Получить на: https://console.deepgram.com/signup
DEEPGRAM_API_KEY=

# ОПЦИОНАЛЬНО: ElevenLabs Flash v2.5 (текст → голос)
# Бесплатно: 20к символов/мес (0.5 кредита/символ × 10к кредитов)
# Для личного использования (без коммерческой лицензии) — достаточно
# Получить: https://elevenlabs.io/app/sign-up
ELEVENLABS_API_KEY=

# ОПЦИОНАЛЬНО: Google Cloud TTS Neural2 (текст → голос, альтернатива ElevenLabs)
# Бесплатно: 1 млн символов/мес для стандартных голосов
# Болгарский: bg-BG-Standard-A | Английский: en-US-Neural2-F
# Получить: https://console.cloud.google.com/apis/library/texttospeech.googleapis.com
GOOGLE_TTS_API_KEY=

# Переключение TTS провайдера — в настройках приложения (ElevenLabs / Google)
# По умолчанию используется тот, чей ключ задан первым

# Сервер
PORT=5000
NODE_ENV=development
